# Copy to `.env` (git-ignored) and fill in. All values are OPTIONAL — with none of
# them set the site builds and runs exactly as before, just without measurement.
# Vite only exposes vars prefixed with VITE_, and they are inlined at BUILD time,
# so a rebuild is required after changing them.

# --- Google Analytics 4 -------------------------------------------------------
# TODO: create the GA4 property for sharona-bar-nes.com and paste its
# Measurement ID here (format: G-XXXXXXXXXX). Do not guess one.
VITE_GA_ID=

# --- Google Search Console ----------------------------------------------------
# TODO: only needed if verifying via the HTML meta-tag method. Paste the token
# from the `content="..."` attribute GSC gives you (NOT the whole tag).
# Alternatives that need no code change:
#   * DNS TXT record on the domain (recommended — verifies the whole domain)
#   * HTML file upload: drop googleXXXX.html into /public, it is copied to /dist
VITE_GOOGLE_SITE_VERIFICATION=

# --- Google Ads (later) -------------------------------------------------------
# TODO: Ads conversion / remarketing id (format: AW-XXXXXXXXX). Setting it makes
# the shared gtag loader configure Ads too — no other code change needed.
VITE_GOOGLE_ADS_ID=
# TODO: full send_to value of the conversion action (format: AW-XXXXXXXXX/AbC-D_efG).
# When present, a successful contact-form submit also fires an Ads `conversion`.
VITE_GOOGLE_ADS_CONVERSION_LABEL=
